# Single lockfile: bun.lock is the source of truth. Guard against a stray
# npm/pnpm install dropping a competing lockfile that would drift from bun.lock.
package-lock.json
npm-shrinkwrap.json
pnpm-lock.yaml
yarn.lock

# Demo recordings: regenerate with scripts/demo/record.sh. The scripts are
# the source of truth, the video files are build output — and a 20MB capture
# has no business in git history.
scripts/demo/out/
