{
  "name": "@diffstalker/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "bun": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "lint": "eslint src/ && bunx --bun depcruise src/ --config .dependency-cruiser.cjs",
    "lint:fix": "eslint src/ --fix",
    "deps": "bunx --bun depcruise src/ --config .dependency-cruiser.cjs",
    "test": "bun test src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "fast-diff": "^1.3.0",
    "fzf": "^0.5.2",
    "ignore": "^7.0.5",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.0",
    "prettier": "^3.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "web-tree-sitter": "0.26.13"
  }
}
