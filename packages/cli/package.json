{
  "name": "diffstalker",
  "version": "0.11.0",
  "description": "Interactive terminal UI for git staging, committing, and live diff review",
  "author": "yogh-io",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yogh-io/diffstalker.git"
  },
  "homepage": "https://github.com/yogh-io/diffstalker#readme",
  "bugs": {
    "url": "https://github.com/yogh-io/diffstalker/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "diffstalker": "bin/diffstalker"
  },
  "files": [
    "dist/index.js",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "rm -rf dist && tsc -b",
    "build:prod": "bun run build && bun build dist/index.js --outfile dist/index.js --minify --target node --external emphasize --external fast-diff --external fzf --external lowlight --external neo-blessed",
    "start": "bun dist/index.js",
    "test": "bun test src/",
    "test:watch": "bun test --watch src/",
    "lint": "eslint src/ && bunx --bun depcruise src/ --config .dependency-cruiser.cjs",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "deps": "bunx --bun depcruise src/ --config .dependency-cruiser.cjs",
    "metrics": "bun ../../scripts/collect-metrics.ts",
    "metrics:snapshot": "bun ../../scripts/collect-metrics.ts --save",
    "prepublishOnly": "bun run build:prod",
    "prepack": "cp ../../README.md ../../LICENSE ../../CHANGELOG.md .",
    "postpack": "rm -f README.md LICENSE CHANGELOG.md"
  },
  "keywords": [
    "git",
    "diff",
    "terminal",
    "tui",
    "cli"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "diffstalkerd": "workspace:*",
    "emphasize": "^7.0.0",
    "fast-diff": "^1.3.0",
    "fzf": "^0.5.2",
    "lowlight": "^3.1.0",
    "neo-blessed": "0.2.0"
  },
  "devDependencies": {
    "@diffstalker/client": "workspace:*",
    "@diffstalker/core": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/blessed": "^0.1.27",
    "@types/node": "^26.1.1",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.0",
    "prettier": "^3.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
