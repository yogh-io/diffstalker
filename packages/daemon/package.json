{
  "name": "diffstalkerd",
  "version": "0.5.1",
  "description": "diffstalker daemon: REST API + SSE git state over a unix socket",
  "author": "yogh-io",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yogh-io/diffstalker.git"
  },
  "homepage": "https://github.com/yogh-io/diffstalker#readme",
  "bugs": {
    "url": "https://github.com/yogh-io/diffstalker/issues"
  },
  "type": "module",
  "bin": {
    "diffstalkerd": "bin/diffstalkerd"
  },
  "files": [
    "dist/index.js",
    "dist/web",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "rm -rf dist && tsc -b",
    "build:web": "cd ../web && bun run build && cd ../daemon && bun scripts/copyWebDist.ts",
    "build:prod": "bun run build && bun run build:web && bun build dist/index.js --outfile dist/index.js --minify --target node --external chokidar --external simple-git --external ignore",
    "start": "bun dist/index.js",
    "test": "bun test src/*.test.ts src/**/*.test.ts",
    "test:watch": "bun test --watch src/*.test.ts src/**/*.test.ts",
    "lint": "eslint src/ && depcruise src/ --config .dependency-cruiser.cjs",
    "lint:fix": "eslint src/ --fix",
    "deps": "depcruise src/ --config .dependency-cruiser.cjs",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepublishOnly": "bun run build:prod",
    "prepack": "cp ../../LICENSE .",
    "postpack": "rm -f LICENSE"
  },
  "keywords": [
    "git",
    "diff",
    "daemon",
    "diffstalker"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "ignore": "^7.0.5",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@diffstalker/core": "workspace:*",
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.10.7",
    "dependency-cruiser": "^17.3.7",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^3.0.6",
    "prettier": "^3.8.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.53.1"
  }
}
