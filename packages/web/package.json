{
  "name": "@diffstalker/web",
  "version": "0.0.0",
  "description": "diffstalker web UI: a browser client for diffstalkerd, served by the daemon",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ vite.config.ts && bunx --bun depcruise src/ --config .dependency-cruiser.cjs",
    "lint:fix": "eslint src/ vite.config.ts --fix",
    "deps": "bunx --bun depcruise src/ --config .dependency-cruiser.cjs",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@diffstalker/client": "workspace:*",
    "@diffstalker/core": "workspace:*",
    "fzf": "^0.5.2",
    "highlight.js": "^11.11.1",
    "pinia": "^4.0.2",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.0",
    "prettier": "^3.8.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  }
}
