{
  "name": "@diffstalker/client",
  "version": "0.0.0",
  "description": "Typed REST + SSE client for diffstalkerd",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b",
    "test": "bun test src/",
    "test:watch": "bun test --watch src/",
    "lint": "eslint src/ && bunx --bun depcruise src/ --config .dependency-cruiser.cjs",
    "lint:fix": "eslint src/ --fix",
    "deps": "bunx --bun depcruise src/ --config .dependency-cruiser.cjs",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@diffstalker/core": "workspace:*",
    "diffstalkerd": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.0",
    "prettier": "^3.8.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
