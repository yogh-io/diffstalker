{
  "name": "@diffstalker/client",
  "version": "0.4.0",
  "description": "Typed REST + SSE client for diffstalkerd",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b",
    "test": "bun test src/*.test.ts src/**/*.test.ts",
    "test:watch": "bun test --watch src/*.test.ts src/**/*.test.ts",
    "lint": "eslint src/ && depcruise src/ --config .dependency-cruiser.cjs",
    "lint:fix": "eslint src/ --fix",
    "deps": "depcruise src/ --config .dependency-cruiser.cjs",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@diffstalker/core": "workspace:*",
    "@diffstalker/daemon": "workspace:*",
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.10.7",
    "dependency-cruiser": "^17.3.7",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^3.0.6",
    "prettier": "^3.8.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.53.1"
  }
}
